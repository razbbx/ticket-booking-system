{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ticket-booking-system",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "not_found_handling": "single-page-application" },
  "triggers": { "crons": ["*/1 * * * *"] },
  "vars": {
    "APP_URL": "https://ticket-booking-system.fshare-ayush-demo.workers.dev",
    "HOLD_TTL_MINUTES": "10",
    "OFFER_TTL_MINUTES": "10"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ticket-booking-db", "database_id": "d10d6801-a89a-47a7-8f24-e9bee6ef3e20", "migrations_dir": "./migrations" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}