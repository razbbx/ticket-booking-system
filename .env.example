# Server configuration
PORT=3000

# Secret used to sign JWT auth tokens - use a long random string (e.g. `openssl rand -hex 32`)
SECRET=change-me-to-a-long-random-string

# Minutes a held seat stays locked before it is auto-released
HOLD_TTL_MINUTES=10

# Minutes a waitlist offer (seat-hold for next-in-line) stays valid
OFFER_TTL_MINUTES=10

# Public base URL used in emails and links (use your deployed URL in production)
APP_URL=http://localhost:3000

# SMTP settings for sending QR ticket emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticket Booking System <no-reply@example.com>"
