# Environment Variables Configuration Example
# Copy this file to .dev.vars for wrangler local development

# Application Base URL
APP_URL=https://ticket-booking-system.fshare-ayush-demo.workers.dev

# JWT Authentication Secret
SECRET=your-super-secret-jwt-key-here

# Seat Hold TTL in minutes
HOLD_TTL_MINUTES=10

# Waitlist Offer TTL in minutes
OFFER_TTL_MINUTES=10

# Resend API Key for Email Delivery (Optional free tier integration)
RESEND_API_KEY=re_your_resend_api_key_here
