{
  "name": "ticket-booking-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply:local": "wrangler d1 execute ticket-booking-db --local --file=./migrations/0001_init.sql",
    "db:apply:remote": "wrangler d1 execute ticket-booking-db --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute ticket-booking-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute ticket-booking-db --remote --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}